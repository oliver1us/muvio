# Secrets only. Non-sensitive Docker settings are documented in compose.yml.
# Local runs also accept all compose environment names in .env.

# Long random installation/admin key. Required for Settings, models and
# transcription, even when anonymous downloads are allowed.
API_KEY=

# Optional stable signing secret (at least 32 random bytes recommended).
# If empty, Muvio generates STATE_DIR/signing.key with private permissions.
# Keep it and the quota DB across restarts; changing it invalidates sessions.
SIGNING_SECRET=

# Optional transcript cleanup provider credential. Never sent to visitors.
LLM_API_KEY=
