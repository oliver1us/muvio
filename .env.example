# Directory containing downloads, history, and local configuration.
OUTPUT_DIR=./data/downloads
# Directory for explicitly downloaded Whisper models.
MODELS_DIR=./data/models
# Maximum number of concurrent jobs.
MAX_CONCURRENT_JOBS=3
# Whisper model name; download explicitly via the settings endpoint.
WHISPER_MODEL=large-v3-turbo
# Whisper execution device and compute type.
WHISPER_DEVICE=auto
WHISPER_COMPUTE_TYPE=auto
# Enable optional vocal separation when installed.
DEMUCS_ENABLED=false
# Demucs model name.
DEMUCS_MODEL=mdx_extra
# FFmpeg executable path.
FFMPEG_PATH=ffmpeg
# Maximum uploaded audio size in megabytes.
MAX_UPLOAD_MB=200
# Maximum job submissions from one IP per window.
RATE_LIMIT_MAX=10
# Rate-limit window in seconds.
RATE_LIMIT_WINDOW=60
# Optional authentication for exposed installations.
API_KEY_REQUIRED=false
# Authentication secret; required when API_KEY_REQUIRED=true.
API_KEY=
# Comma-separated allowed CORS origins; empty disables cross-origin access.
CORS_ALLOW_ORIGIN=
# Set a persistent signing secret for links that survive restarts.
SIGNING_SECRET=
# Optional transcript cleanup provider base URL (off by default).
LLM_BASE_URL=
# Optional transcript cleanup provider API key.
LLM_API_KEY=
# Optional transcript cleanup provider model.
LLM_MODEL=
# Optional provider: openai-compatible, anthropic, or ollama.
LLM_PROVIDER=openai-compatible
# Enable optional transcript cleanup.
ENABLE_LLM_CLEANUP=false
